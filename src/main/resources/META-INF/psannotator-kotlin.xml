<!-- Loaded only when the Kotlin plugin is installed. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.dush.psannotator">
        <tagModelProvider implementation="com.dush.psannotator.kotlin.KotlinTagModelProvider" order="first"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <!-- Only PSI is used (no type analysis), so the plugin works in both K1 and K2 mode. -->
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="kotlin" shortName="ProtostuffTagKotlin"
                         displayName="Protostuff @Tag problems (Kotlin)" groupName="Protostuff"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="com.dush.psannotator.kotlin.ProtostuffTagKotlinInspection"/>
        <intentionAction>
            <language>kotlin</language>
            <className>com.dush.psannotator.kotlin.AddTagKotlinIntention</className>
            <category>Protostuff</category>
        </intentionAction>
    </extensions>
</idea-plugin>
